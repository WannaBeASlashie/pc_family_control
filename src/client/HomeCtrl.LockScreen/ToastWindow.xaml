<Window x:Class="HomeCtrl.LockScreen.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HomeCtrl.Toast" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        Background="Transparent" AllowsTransparency="True">
    <Border Background="#E5161D2E" CornerRadius="12" Padding="18,12" Margin="10">
        <TextBlock x:Name="ToastText" Text="" Foreground="#FBBF24" FontSize="15"
                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
