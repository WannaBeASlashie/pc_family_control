<Window x:Class="HomeCtrl.LockScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="家庭电脑"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False"
        Background="#0E1420"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <!-- 登录面板：无会话时显示 -->
        <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
            <TextBlock Text="家庭电脑" FontSize="42" FontWeight="Bold"
                       Foreground="#E8ECF4" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="请输入卡号与 PIN 上机" FontSize="15"
                       Foreground="#8A93A8" HorizontalAlignment="Center" Margin="0,0,0,36"/>

            <TextBlock Text="卡号" Foreground="#AAB3C5" FontSize="13" Margin="2,0,0,4"/>
            <TextBox x:Name="CardBox" Height="44" FontSize="18" VerticalContentAlignment="Center"
                     Background="#1A2233" Foreground="#E8ECF4" BorderBrush="#2A3550"
                     BorderThickness="1" Padding="8,0" CaretBrush="#7DD3FC"/>

            <TextBlock Text="PIN" Foreground="#AAB3C5" FontSize="13" Margin="2,14,0,4"/>
            <PasswordBox x:Name="PinBox" Height="44" FontSize="18" VerticalContentAlignment="Center"
                         Background="#1A2233" Foreground="#E8ECF4" BorderBrush="#2A3550"
                         BorderThickness="1" Padding="8,0"/>

            <Button x:Name="LoginBtn" Content="上 机" Height="48" FontSize="20" FontWeight="SemiBold"
                    Margin="0,28,0,0" Background="#3B82F6" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="OnLogin"/>
        </StackPanel>

        <!-- 耗尽面板：会话还在但被锁定（余额耗尽）时显示 -->
        <StackPanel x:Name="ExhaustedPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Visibility="Collapsed">
            <TextBlock Text="⏰" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="ExhaustedName" Text="—" FontSize="30" FontWeight="Bold"
                       Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="时间已用完" FontSize="17"
                       Foreground="#8A93A8" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <UniformGrid Columns="2">
                <Button x:Name="Req15Btn" Content="申请 +15 分钟" Height="46" FontSize="16" Margin="0,0,6,0"
                        Background="#F59E0B" Foreground="#1A1200" BorderThickness="0" Cursor="Hand" Click="OnRequest15"/>
                <Button x:Name="Req30Btn" Content="申请 +30 分钟" Height="46" FontSize="16" Margin="6,0,0,0"
                        Background="#F59E0B" Foreground="#1A1200" BorderThickness="0" Cursor="Hand" Click="OnRequest30"/>
            </UniformGrid>

            <Button x:Name="GiveUpBtn" Content="结束并下机" Height="42" FontSize="14" Margin="0,14,0,0"
                    Background="#252F47" Foreground="#AAB3C5" BorderThickness="0" Cursor="Hand" Click="OnGiveUp"/>
            <TextBlock x:Name="OfflineReqHint" Text="离线模式暂不可申请加时" Foreground="#8A93A8" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 共用状态行 -->
        <TextBlock x:Name="StatusText" Foreground="#F87171" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,320,0,0"
                   TextWrapping="Wrap" Panel.ZIndex="10"/>

        <TextBlock x:Name="FooterText" Text="" Foreground="#5A6478" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>

        <TextBlock x:Name="TestHint" Text="[TEST MODE] ESC to exit" Foreground="#F59E0B" FontSize="13"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>
